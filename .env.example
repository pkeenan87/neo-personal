# =============================================================================
# Neo environment variables
#
# Copy next to the Next.js app (Next.js loads env files from apps/web/):
#   cp .env.example apps/web/.env.local
# Package tests and scripts read process.env; see docs/development.md.
#
# Nothing here is required for local development: with MOCK_MODE=true every
# external API returns fixtures, and DEV_AUTH_BYPASS=true skips sign-in.
# Every variable the code reads must be listed here with a comment.
# NEVER put real values in this file; it is committed.
# =============================================================================


# -----------------------------------------------------------------------------
# Anthropic (Claude)
# -----------------------------------------------------------------------------
# API key from https://console.anthropic.com. Required unless MOCK_MODE=true,
# which runs the real agent loop against a scripted offline model (no key, no
# network). With neither, POST /api/agent returns 503.
ANTHROPIC_API_KEY=
# Alternative to ANTHROPIC_API_KEY: a bearer token (read by the Anthropic SDK).
# ANTHROPIC_AUTH_TOKEN=

# Chat agent model. Adaptive thinking is on by default; depth is set by effort.
NEO_AGENT_MODEL=claude-opus-5
# Conversation compression and titles.
NEO_COMPRESSION_MODEL=claude-haiku-4-5
# Bulk auto-triage of forwarded messages (Phase 1).
NEO_TRIAGE_MODEL=claude-sonnet-5
# Server-side model fallbacks for refusal handling (true/false).
NEO_ENABLE_FALLBACKS=true
# output_config.effort for chat turns: low | medium | high.
NEO_AGENT_EFFORT=medium
# Cost ceiling on estimated input tokens per model call; older turns are
# compressed (NEO_COMPRESSION_MODEL) or dropped above it. Default 180000.
NEO_CONTEXT_MAX_INPUT_TOKENS=180000
# Per-tool-result cap (tokens) applied when a result enters the model. Default 25000.
NEO_TOOL_RESULT_MAX_TOKENS=25000


# -----------------------------------------------------------------------------
# Database (Postgres)
# -----------------------------------------------------------------------------
# Connect as the NON-superuser application role so row-level security applies.
# Local example (docker/postgres):  postgres://app_user:app_user@localhost:5432/neo
# Neon example:                     postgres://app_user:<password>@ep-xxxx.us-east-2.aws.neon.tech/neo?sslmode=require
# Unset = no database: conversations, usage and audit live in memory (MOCK_MODE
# demo and tests only; sign-in providers need a database and are hidden).
DATABASE_URL=
# Optional override that wins over DATABASE_URL. Use it when a marketplace integration
# (Neon on Vercel) manages DATABASE_URL with the owner role: leave that alone and put the
# app_user connection string here so the app runs under row-level security.
NEO_DATABASE_URL=
# Owner role used only by migrations (pnpm db:migrate, drizzle-kit). The app must
# NOT connect as the owner or RLS does not apply (packages/db/docs/rls.md).
# Unset = migrations use DATABASE_URL.
MIGRATION_DATABASE_URL=
# Driver: "neon" (@neondatabase/serverless, for Neon/Vercel) or "pg" (node-postgres,
# for local Postgres). Unset = auto: "neon" when the host ends in neon.tech, else "pg".
NEO_DB_DRIVER=


# -----------------------------------------------------------------------------
# Auth.js v5
# -----------------------------------------------------------------------------
# Random secret for signing sessions. Generate with:  openssl rand -base64 32
AUTH_SECRET=
# Canonical app URL. Leave unset on Vercel (derived automatically).
AUTH_URL=http://localhost:3000
# Trust the X-Forwarded-Host header. true on Vercel and behind a reverse proxy.
AUTH_TRUST_HOST=true

# A provider is shown only when its variables are set (and DATABASE_URL is set).
# Google OAuth client (https://console.cloud.google.com/apis/credentials).
# Redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend API key for magic-link sign-in emails (https://resend.com/api-keys).
# Unset + MOCK_MODE=true on a local (non-deployed) server: the link is printed
# to the server console instead of emailed.
# The Resend marketplace integration on Vercel sets MESSAGING_RESEND_API_KEY instead;
# either name works (RESEND_API_KEY > AUTH_RESEND_KEY > MESSAGING_RESEND_API_KEY).
AUTH_RESEND_KEY=
# Sender for sign-in and notification emails. Must be on a domain verified in Resend.
# Unset with the Resend integration: defaults to Neo <neo@MESSAGING_RESEND_EMAIL_DOMAIN>.
EMAIL_FROM="Neo <neo@example.com>"


# -----------------------------------------------------------------------------
# URL analyzers
# Each client returns { skipped: "no_api_key" } when its key is unset.
# -----------------------------------------------------------------------------
# Google Safe Browsing / Web Risk API key.
GOOGLE_SAFE_BROWSING_API_KEY=
# VirusTotal API key. Free tier is 4 requests/minute.
VIRUSTOTAL_API_KEY=
# Submit URLs VirusTotal has never seen for scanning (true/false, default true).
# Submissions are visible to VirusTotal's community; set false to only look up.
VIRUSTOTAL_SUBMIT=true
# urlscan.io API key for screenshots and DOM.
URLSCAN_API_KEY=
# Submit URLs to urlscan.io. Off by default: submissions can be public on
# urlscan's side depending on visibility settings. true/false.
URLSCAN_ENABLED=false


# -----------------------------------------------------------------------------
# Usage caps (per household tenant). Tunable without a code change. On Vercel,
# env var changes take effect on the next deployment (use "Redeploy").
# -----------------------------------------------------------------------------
# Agent checks (POST /api/agent turns) per tenant per calendar month (UTC).
USAGE_CAP_MONTHLY_CHECKS=50
# Input + output tokens per tenant per UTC day.
USAGE_CAP_DAILY_TOKENS=300000


# -----------------------------------------------------------------------------
# Development and safety switches
# -----------------------------------------------------------------------------
# Use deterministic fixtures for every external API (Claude, analyzers, email).
MOCK_MODE=true
# Skip sign-in with a seeded dev user and tenant. Ignored when NODE_ENV is
# "production" or VERCEL_ENV is "production" or "preview", whatever this says.
# With DATABASE_URL set the dev user and household are created on first use;
# without it a fixed in-memory dev tenant is used.
DEV_AUTH_BYPASS=false
# Identity of the DEV_AUTH_BYPASS user.
DEV_USER_EMAIL=dev@neo.local
DEV_USER_NAME=Dev User
# Delay (ms) between streamed events of the MOCK_MODE scripted model, so the UI
# visibly streams. 0 = no delay. Default 35.
MOCK_STREAM_DELAY_MS=35
# Prompt-injection guard on user input: monitor (log only) | block (refuse).
INJECTION_GUARD_MODE=monitor
# debug | info | warn | error
LOG_LEVEL=info
# Contact address shown on the privacy policy page. Default: privacy@neoshield.dev.
NEO_CONTACT_EMAIL=
# Version reported by GET /api/health. Default: apps/web/package.json version.
# (VERCEL_ENV and VERCEL_GIT_COMMIT_SHA are set by Vercel and also read.)
# APP_VERSION=


# -----------------------------------------------------------------------------
# Artifacts: uploaded .eml files, screenshots and forwarded mail (Phase 1)
# Encrypted at rest; deleted by the daily retention job (Inngest artifacts-expire).
# -----------------------------------------------------------------------------
# Vercel Blob read-write token (private store). Unset = in-memory blob client:
# fine for MOCK_MODE and local dev, but files are lost on restart and are not
# shared between serverless instances. On a deployment without MOCK_MODE, unset
# means uploads are refused (503 storage_unavailable) and GET /api/health
# reports artifacts: "unconfigured".
# Stores created by the Vercel Blob integration use OIDC instead: they set BLOB_STORE_ID
# (and no token), which the app also accepts. Leave both unset for the in-memory client.
BLOB_READ_WRITE_TOKEN=
# Master key for artifact envelope encryption (AES-256-GCM with per-tenant keys
# derived by HKDF). 32 random bytes, base64:  openssl rand -base64 32
# Required when VERCEL_ENV=production, and with DATABASE_URL unless MOCK_MODE=true;
# otherwise unset stores files unencrypted (local dev only). A malformed value
# disables artifacts. Losing it makes stored artifacts unreadable.
NEO_MASTER_KEY=
# Days an artifact is kept before the retention job deletes it. Default 30.
NEO_ARTIFACT_RETENTION_DAYS=30


# -----------------------------------------------------------------------------
# Forward-to-address: inbound email, background jobs, result emails (Phase 1)
# Everything works unset: the settings page says forwarding is not configured,
# the webhook returns 503, and GET /api/health reports inbound: "unconfigured".
# With MOCK_MODE=true and no INNGEST_EVENT_KEY the job runs inline from the
# webhook and result emails are recorded instead of sent.
# -----------------------------------------------------------------------------
# Domain the household addresses live on (check-xxxxxxxxxxxx@<domain>). Configure
# it as a receiving domain in Resend and point its MX records at Resend.
NEO_INBOUND_DOMAIN=
# Signing secret (whsec_...) of the Resend webhook for the email.received event,
# pointed at <app URL>/api/inbound/resend. Unset = the webhook returns 503.
RESEND_WEBHOOK_SECRET=
# Resend API key used to fetch received mail and send result emails. Optional:
# defaults to AUTH_RESEND_KEY (the magic-link key).
RESEND_API_KEY=
# Inngest Cloud keys (https://app.inngest.com). Sync <app URL>/api/inngest in Inngest.
# Unset locally: run `npx inngest-cli@latest dev` with INNGEST_DEV=1, or rely on
# MOCK_MODE running the job inline.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Read by the inngest SDK itself: 1 (or a dev-server URL) = talk to the local dev server.
# INNGEST_DEV=
# Forwarded messages accepted per household address per hour; the rest are
# recorded as rejected. Default 30.
NEO_INBOUND_RATE_LIMIT_PER_HOUR=30
# Links in result emails use AUTH_URL; on Vercel with AUTH_URL unset they use
# VERCEL_PROJECT_PRODUCTION_URL (set by Vercel), else http://localhost:3000.

{
  "name": "@neo/core",
  "version": "0.0.0",
  "private": true,
  "description": "Neo agent loop, tool registry, and safeguards (prompt-injection guard, context management, logging)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {

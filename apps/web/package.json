    "@neo/tools": "workspace:*",
    "@neo/verdict": "workspace:*",
    "@vercel/kms": "0.3.8",
    "ai": "7.0.159",
    "drizzle-orm": "^0.45.4",
    "eve": "1.0.0-rc.6",
    "inngest": "4.26.2",
    "lucide-react": "1.65.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",

{
  "name": "@neo/web",
  "version": "0.0.0",
  "private": true,
  "description": "Neo web app: landing, auth, and chat UI",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
